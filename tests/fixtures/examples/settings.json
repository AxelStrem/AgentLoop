{
  "format": 1,
  "workers": [
    {
      "name": "account1",
      "claude": "~/.claude-account1",
      "overseer": {
        "server": "https://overseer.example.com",
        "keyFile": "~/.overseer/agents.key"
      }
    },
    {
      "name": "account2",
      "claude": "~/.claude-account2",
      "overseer": {
        "server": "https://overseer.example.org",
        "keyFile": "~/.overseer/other-agents.key"
      }
    }
  ],
  "loops": [
    {
      "name": "quill",
      "tracker": "alice/projects/quill.os",
      "worker": "account1",
      "repos": {
        "quill": "~/src/Quill"
      },
      "places": {
        "press": "C:/Program Files/Press"
      },
      "settings": {
        "chainUpTo": 2
      }
    },
    {
      "name": "orchard",
      "tracker": "alice/projects/orchard.os",
      "worker": "account2",
      "repos": {
        "orchard": "~/src/Orchard",
        "orchard-server": "~/src/Orchard-Server",
        "orchard-docs": "~/src/Orchard-Docs/shared"
      },
      "settings": {}
    }
  ],
  "defaults": {
    "askEveryMinutes": 60
  },
  "install": null,
  "server": {
    "host": "127.0.0.1",
    "port": 8765
  }
}
